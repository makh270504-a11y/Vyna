// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  tagline  String
  image    String
  products Product[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  price            Int
  oldPrice         Int?
  isNew            Boolean            @default(false)
  inStock          Boolean            @default(true)
  stock            Int                @default(0)
  shortDescription String             @db.Text
  description      String             @db.Text
  images           ProductImage[]
  informations     ProductInfo[]
  sizes            String?            @db.Text // stored as JSON array of strings
  colors           String?            @db.Text // stored as JSON array of hex codes
  variants         ProductVariant?
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductInfo {
  id        String  @id @default(cuid())
  value     String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_infos")
}

model ProductVariant {
  id        String   @id @default(cuid())
  label     String
  options   String   @db.Text // stored as JSON array
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int
  text      String   @db.Text
  date      DateTime
  status    String   @default("PENDING") // "PENDING", "PUBLISHED", "REJECTED"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Orders (for Admin)
// ---------------------------------------------------------------------------

model Order {
  id                    String        @id @default(cuid())
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod @default(COD)
  paymentProofUrl       String?       // Screenshot URL for manual payment proof
  paymentTransactionId  String?       // CinetPay transaction ID for webhook matching
  firstName       String
  lastName        String
  email           String
  phone           String
  country         String
  city            String
  address         String
  complement      String?
  items           OrderItem[]
  subtotal        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
  variant   String?
  image     String?

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  COD
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Promotion {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    // "PERCENTAGE" or "FIXED"
  discountValue Int
  isActive      Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Shipping Rules
// ---------------------------------------------------------------------------

model ShippingRule {
  id          String   @id @default(cuid())
  name        String
  zone        String   // e.g., "FR", "EU", "INTL"
  price       Int
  minOrderVal Int?     // Minimum order value for this rule to apply (e.g. free shipping over 100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shipping_rules")
}

// ---------------------------------------------------------------------------
// Static Pages
// ---------------------------------------------------------------------------

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Global Settings
// ---------------------------------------------------------------------------

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Journal Articles
// ---------------------------------------------------------------------------

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.LongText
  category    String
  readTime    String
  image       String   @default("")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("articles")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
